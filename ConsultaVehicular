    <script>
        const placaInput = document.getElementById('placa');

        // Cargar placa guardada
        window.addEventListener('load', () => {
            const saved = localStorage.getItem('placaVehicular');
            if (saved) placaInput.value = saved;
            validarPlaca();
        });

        // Guardar y validar al escribir
        placaInput.addEventListener('input', (e) => {
            let val = e.target.value.toUpperCase().replace(/[^A-Z0-9-]/g, '');
            if (val.length > 3 && val.charAt(3) !== '-') val = val.slice(0,3) + '-' + val.slice(3);
            if (val.length > 8) val = val.slice(0,8);
            e.target.value = val;
            localStorage.setItem('placaVehicular', val.trim());
            validarPlaca();
        });

        function validarPlaca() {
            const val = placaInput.value.trim();
            if (/^[A-Z]{3}-[0-9]{3}$/.test(val)) {
                placaInput.classList.add('border-acento-verde', 'border-2');
                placaInput.classList.remove('border-red-500');
            } else if (val) {
                placaInput.classList.add('border-red-500', 'border-2');
                placaInput.classList.remove('border-acento-verde');
            } else {
                placaInput.classList.remove('border-acento-verde', 'border-red-500', 'border-2');
            }
        }

        // Limpiar
        document.getElementById('clearPlaca').addEventListener('click', () => {
            placaInput.value = '';
            localStorage.removeItem('placaVehicular');
            placaInput.classList.remove('border-acento-verde', 'border-red-500', 'border-2');
        });

        // Copiar en silencio al clic en enlace
        document.querySelectorAll('.consulta').forEach(a => {
            a.addEventListener('click', e => {
                const placa = placaInput.value.trim();
                if (!placa) return;  // No hace nada si está vacío

                if (/^[A-Z]{3}-[0-9]{3}$/.test(placa)) {
                    navigator.clipboard.writeText(placa).catch(() => {
                        // Falla silenciosa, no mostramos nada
                    });
                }
                // No hay alert ni mensaje aquí
            });
        });

        // Toggle tema
        const toggle = document.getElementById('themeToggle');
        toggle.addEventListener('click', () => {
            document.documentElement.classList.toggle('dark');
            toggle.textContent = document.documentElement.classList.contains('dark') ? '☀️' : '🌙';
        });
    </script>
    <script>
    const themeToggle = document.getElementById('theme-toggle');
    const sunIcon = themeToggle.querySelector('.sun');
    const moonIcon = themeToggle.querySelector('.moon');

    // Cargar preferencia guardada
    if (localStorage.getItem('theme') === 'light' || 
        (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: light)').matches)) {
        document.body.classList.add('light');
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
    }

    themeToggle.addEventListener('click', () => {
        document.body.classList.toggle('light');
        document.body.style.background = document.body.classList.contains('light') 
    ? 'linear-gradient(135deg, #f8fafc, #e2e8f0)' 
    : 'linear-gradient(135deg, #0f172a, #0a0f1a)';
        
        if (document.body.classList.contains('light')) {
            localStorage.setItem('theme', 'light');
            sunIcon.classList.add('hidden');
            moonIcon.classList.remove('hidden');
        } else {
            localStorage.setItem('theme', 'dark');
            sunIcon.classList.remove('hidden');
            moonIcon.classList.add('hidden');
        }
    });
</script>
